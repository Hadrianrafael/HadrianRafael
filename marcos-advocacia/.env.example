# ------------------------------------------------------------
# Variáveis de ambiente — MDSilva Advocacia
# Copie para .env.local (desenvolvimento) ou cadastre na Vercel
# (Project Settings → Environment Variables).
# NUNCA faça commit de valores reais.
# Todas são opcionais: sem elas o site funciona, e cada integração
# fica desativada de forma transparente.
# Variáveis NEXT_PUBLIC_* são lidas no build: após alterá-las,
# faça um novo deploy.
# ------------------------------------------------------------

# Domínio oficial (sem barra no final). Usado em canonical, sitemap,
# Open Graph e dados estruturados. Ex.: https://www.seudominio.com.br
NEXT_PUBLIC_SITE_URL=

# --- Formulário de contato (Resend) ---------------------------
# Sem RESEND_API_KEY e CONTACT_FROM_EMAIL o formulário aparece
# desativado, com aviso para usar WhatsApp/telefone/e-mail.
RESEND_API_KEY=
# Remetente de um domínio verificado no Resend. Ex.: Site <contato@seudominio.com.br>
CONTACT_FROM_EMAIL=
# Destinatário das mensagens (padrão: mdireitosilva@yahoo.com.br)
CONTACT_TO_EMAIL=

# --- Proteção antirrobô (Cloudflare Turnstile, opcional) ------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Google ---------------------------------------------------
# Google Analytics 4 (formato G-XXXXXXXXXX). Só carrega após consentimento.
NEXT_PUBLIC_GA_ID=
# Google Tag Manager (formato GTM-XXXXXXX). Use GA4 OU GTM, não ambos.
NEXT_PUBLIC_GTM_ID=
# Google Search Console: valor do atributo "content" da meta tag de verificação.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Redes sociais --------------------------------------------
# Endereço exato da página "MDSilva - Advocacia" no Facebook.
# Enquanto vazio, o link leva à busca pelo nome da página.
NEXT_PUBLIC_FACEBOOK_URL=

# --- Atendimento com IA (campanha) ----------------------------
# "true" exibe, na página de vínculo empregatício, o canal
# (11) 97871-0130, identificado como atendimento automatizado.
# Ative somente quando a integração de IA estiver em funcionamento.
NEXT_PUBLIC_AI_ATTENDANCE_ENABLED=false
